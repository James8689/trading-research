+    ]),
+  );
+}
+
+function controlPanel() {
+  const box = card('Control', []);
+  const seed = el('button', { text: 'Seed CEF cycle', onclick: () => command('seed-cef') });
+  const stop = el('button', { class: 'ghost', text: 'Stop network', onclick: () => {
