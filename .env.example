# Copy to .env in the repository root (gitignored). Do not commit secrets.
# Existing process environment variables win over this file.

DASHBOARD_PASSWORD=choose-a-long-password

# Local test budget. Opens a new period only when the current ledger is the
# placeholder (manual-no-spend / $0) or already matches this period id.
# Cannot raise an existing period's limit. Dollars, not micro-units.
RESEARCH_BUDGET_PERIOD=local-test
RESEARCH_BUDGET_LIMIT_USD=10
RESEARCH_MAX_CALL_USD=0.50

# Optional: if unset, each settled call consumes the full reservation above.
# RESEARCH_USD_PER_MTOK_INPUT=5
# RESEARCH_USD_PER_MTOK_OUTPUT=15

# Providers. Leave a key blank to disable that vendor.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4

# Role routing: provider:model  (provider is openai, anthropic, or xai)
ROLE_DIRECTOR_PLAN=openai:gpt-5.4
ROLE_RESEARCHER=xai:grok-4
ROLE_DATA_AUDITOR=xai:grok-4
ROLE_REVIEWER=anthropic:claude-sonnet-4-6
ROLE_DIRECTOR_DECISION=openai:gpt-5.4
ROLE_IMPROVEMENT_PROPOSAL=openai:gpt-5.4
