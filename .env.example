# Copy to .env in the repository root (gitignored). Do not commit secrets.
# Existing process environment variables win over this file.

DASHBOARD_PASSWORD=choose-a-long-password

# Local test budget. Opens a new period only when the current ledger is the
# placeholder (manual-no-spend / $0) or already matches this period id.
# Cannot raise an existing period's limit. Dollars, not micro-units.
RESEARCH_BUDGET_PERIOD=local-test
RESEARCH_BUDGET_LIMIT_USD=10
RESEARCH_MAX_CALL_USD=0.50

# Optional: if unset, each settled call consumes the full reservation above.
# RESEARCH_USD_PER_MTOK_INPUT=5
# RESEARCH_USD_PER_MTOK_OUTPUT=15

# Built-in vendors. A vendor is not a model: openai is used twice in the
# intended stack (Sol for orchestration, Astra for escalation). Leave a key
# blank to disable that vendor. OPENAI_MODEL is only a fallback when a role
# is written as "openai:" with no id; prefer explicit provider:model below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=

# Extra vendors (Muse Spark, Groq, Ollama, …). Each name gets
# PROVIDER_<NAME>_KIND (openai or anthropic), _BASE_URL, _API_KEY, _MODEL.
# RESEARCH_PROVIDERS=muse
# PROVIDER_MUSE_KIND=openai
# PROVIDER_MUSE_BASE_URL=https://api.together.xyz/v1
# PROVIDER_MUSE_API_KEY=
# PROVIDER_MUSE_MODEL=

# Intended stack from design/OPPORTUNITY_ENGINE.md. Labels first; replace
# each <callable-id> with the string that vendor actually accepts. Do not
# invent an id. One vendor may appear more than once.
#
#   Sol          openai     GPT-5.6 Sol           director_plan, director_decision, improvement_proposal
#   Astra        openai     GPT-6 Astra           catalog only (no packet role yet)
#   Muse Spark   muse       Meta Muse Spark       researcher   (custom OpenAI-compatible host)
#   Grok         xai        Grok                  data_auditor
#   Sonnet       anthropic  Claude Sonnet-class   reviewer
#
# RESEARCH_MODELS=openai:<sol-id>,openai:<astra-id>,muse:<muse-id>,xai:<grok-id>,anthropic:<sonnet-id>
RESEARCH_MODELS=

# Role routing is per step, not per vendor. Researcher is Muse, not Grok.
# ROLE_DIRECTOR_PLAN=openai:<sol-id>
# ROLE_DIRECTOR_DECISION=openai:<sol-id>
# ROLE_IMPROVEMENT_PROPOSAL=openai:<sol-id>
# ROLE_RESEARCHER=muse:<muse-id>
# ROLE_DATA_AUDITOR=xai:<grok-id>
# ROLE_REVIEWER=anthropic:<sonnet-id>
ROLE_DIRECTOR_PLAN=
ROLE_RESEARCHER=
ROLE_DATA_AUDITOR=
ROLE_REVIEWER=
ROLE_DIRECTOR_DECISION=
ROLE_IMPROVEMENT_PROPOSAL=
